# Supabase — finans semasi (proje: ibbciqycoddyzbyylkad, bolge: ap-northeast-1)
NEXT_PUBLIC_SUPABASE_URL=https://ibbciqycoddyzbyylkad.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Yalniz sunucu tarafi. /api/ingest ucu icin gerekli; Supabase panelinden alinir
# (Project Settings > API Keys > service_role). Tarayiciya ASLA sizmamali.
SUPABASE_SERVICE_ROLE_KEY=

# /api/ingest ucunu koruyan paylasilan sir. Zamanlanmis gorev
# "Authorization: Bearer <INGEST_TOKEN>" basligiyla gonderir.
INGEST_TOKEN=
